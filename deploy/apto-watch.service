[Unit]
Description=apto-watch: procura apartamentos novos e avisa no Telegram
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/Documents/apto-watch
ExecStart=/usr/bin/flock -w 900 %t/apto-watch.lock %h/Documents/apto-watch/.venv/bin/python -m watcher
# Sem reexecução automática em caso de bloqueio: a próxima tentativa é no horário do timer.
